{
  "name": "@web/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "watch:run": "STATIC_DIR=../client/static bun run --watch src/index.ts",
    "build": "bun run build.ts dist/server",
    "check:lint": "biome check .",
    "check:test": "bun test src/",
    "check:type": "tsc --noEmit",
    "fix:lint": "biome check --write .",
    "watch:test": "bun test --watch src/",
    "watch:type": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "hono": "4.13.22"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@types/bun": "^1.3.11",
    "typescript": "^7.0.0"
  }
}
